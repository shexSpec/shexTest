PREFIX sx: <http://www.w3.org/ns/shex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

[] a sx:Schema ;
    sx:shapes ( <http://a.example/B> <http://a.example/A> ) .

<http://a.example/B> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:TripleConstraint ;
      sx:inverse true ;
      sx:predicate <http://a.example/p2> ] ] .

<http://a.example/A> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:TripleConstraint ;
      sx:inverse true ;
      sx:predicate <http://a.example/p1> ] ;
    sx:extends ( <http://a.example/B> ) ] .

