PREFIX ex: <http://a.example>
PREFIX sx: <http://www.w3.org/ns/shex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

[] a sx:Schema ;
    sx:shapes ( <http://a.example/A> <http://a.example/X> <http://a.example/D> ) .

<http://a.example/A> a sx:ShapeDecl ; sx:abstract true ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:TripleConstraint ;
      sx:predicate <http://a.example/p1> ] ] .

<http://a.example/X> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:TripleConstraint ;
      sx:predicate <http://a.example/p3> ] ] .

<http://a.example/D> a sx:ShapeDecl ; sx:shapeExpr [ a sx:ShapeOr ;
    sx:shapeExprs ( <http://a.example/X> [ a sx:Shape ;
      sx:expression [ a sx:TripleConstraint ;
        sx:predicate <http://a.example/p2> ] ;
      sx:extends ( <http://a.example/A> ) ] ) ] .

