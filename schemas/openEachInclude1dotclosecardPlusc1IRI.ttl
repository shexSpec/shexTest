PREFIX ex: <http://a.example>
PREFIX sx: <http://www.w3.org/ns/shex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

[] a sx:Schema ;
    sx:shapes ( <http://a.example/T> <http://a.example/S> ) .

<http://a.example/T> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression <http://a.example/t> ] .

<http://a.example/S> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:EachOf ;
      sx:expressions ( [ a sx:EachOf ;
        sx:expressions ( <http://a.example/t> [ a sx:TripleConstraint ;
          sx:predicate <http://a.example/d> ] ) ;
        sx:min 1 ;
        sx:max -1 ] [ a sx:TripleConstraint ;
        sx:predicate <http://a.example/a> ;
        sx:valueExpr [ a sx:NodeConstraint ;
          sx:nodeKind sx:iri ] ] ) ] ] .

<http://a.example/t> a sx:EachOf ;
  sx:expressions ( [ a sx:TripleConstraint ;
    sx:predicate <http://a.example/b> ] [ a sx:TripleConstraint ;
    sx:predicate <http://a.example/c> ] ) .

